#!/bin/sh

# Git pre-push hook
# Runs comprehensive checks: build and test

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${GREEN}Running pre-push checks...${NC}\n"

# Check if cargo is available
if ! command -v cargo >/dev/null 2>&1; then
    echo "${RED}✗ Error: cargo is not installed${NC}"
    exit 1
fi

# Read the current branch
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")
echo "${BLUE}Current branch: $current_branch${NC}\n"

# 1. Build the project
echo "${YELLOW}[1/6] Building the project...${NC}"
if ! cargo build --all-features; then
    echo "${RED}✗ Build failed!${NC}"
    echo "${YELLOW}Note: Fix the build errors before pushing${NC}"
    exit 1
fi
echo "${GREEN}✓ Build successful${NC}\n"

# 2. Build in release mode
echo "${YELLOW}[2/6] Building in release mode...${NC}"
if ! cargo build --release --all-features; then
    echo "${RED}✗ Release build failed!${NC}"
    echo "${YELLOW}Note: Fix the build errors before pushing${NC}"
    exit 1
fi
echo "${GREEN}✓ Release build successful${NC}\n"

# 3. Run all tests
echo "${YELLOW}[3/6] Running tests...${NC}"
if ! cargo test --all-features; then
    echo "${RED}✗ Tests failed!${NC}"
    echo "${YELLOW}Note: Fix the failing tests before pushing${NC}"
    exit 1
fi
echo "${GREEN}✓ All tests passed${NC}\n"

# 4. Run doc tests
echo "${YELLOW}[4/6] Running doc tests...${NC}"
if ! cargo test --doc --all-features; then
    echo "${RED}✗ Doc tests failed!${NC}"
    echo "${YELLOW}Note: Fix the failing doc tests before pushing${NC}"
    exit 1
fi
echo "${GREEN}✓ Doc tests passed${NC}\n"

# 5. Check documentation builds
echo "${YELLOW}[5/6] Checking documentation...${NC}"
if ! cargo doc --all-features --no-deps --document-private-items; then
    echo "${RED}✗ Documentation build failed!${NC}"
    echo "${YELLOW}Note: Fix the documentation errors before pushing${NC}"
    exit 1
fi
echo "${GREEN}✓ Documentation builds successfully${NC}\n"

# 6. Run benchmarks check
if [ -d "benches" ]; then
    echo "${YELLOW}[6/6] Checking benchmarks compilation...${NC}"
    if ! cargo bench --no-run --all-features; then
        echo "${RED}✗ Benchmark compilation failed!${NC}"
        exit 1
    fi
    echo "${GREEN}✓ Benchmarks compile successfully${NC}\n"
fi

# 7. Check for unused dependencies
if command -v cargo-udeps >/dev/null 2>&1; then
    echo "${YELLOW}[Extra] Checking for unused dependencies...${NC}"
    cargo +nightly udeps --all-targets 2>/dev/null || echo "${YELLOW}! Could not check unused dependencies${NC}"
fi

echo "${GREEN}✓ All pre-push checks passed!${NC}\n"
echo "${GREEN}Ready to push to $current_branch${NC}"

exit 0
