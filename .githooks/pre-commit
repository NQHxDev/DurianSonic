#!/bin/sh

# Git pre-commit hook
# Runs lightweight checks: format and lint

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${GREEN}Running pre-commit checks...${NC}\n"

# Check if cargo is available
if ! command -v cargo >/dev/null 2>&1; then
    echo "${RED}✗ Error: cargo is not installed${NC}"
    exit 1
fi

# 1. Check code formatting with rustfmt
echo "${YELLOW}[1/3] Checking code formatting...${NC}"
if ! cargo fmt --all -- --check; then
    echo "${RED}✗ Code formatting check failed!${NC}"
    echo "${YELLOW}Note: Run 'cargo fmt' to fix formatting issues${NC}"
    exit 1
fi
echo "${GREEN}✓ Code formatting is correct${NC}\n"

# 2. Run clippy for lint checks
echo "${YELLOW}[2/3] Running clippy lint checks...${NC}"
if ! cargo clippy --all-targets --all-features -- -D warnings; then
    echo "${RED}✗ Clippy found issues!${NC}"
    echo "${YELLOW}Note: Fix the warnings above before committing${NC}"
    exit 1
fi
echo "${GREEN}✓ Clippy checks passed${NC}\n"

# 3. Check for common issues in staged files
echo "${YELLOW}[3/4] Checking staged files...${NC}"

# Get list of staged Rust files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -n "$STAGED_RS_FILES" ]; then
    # Check for TODO/FIXME without context
    for file in $STAGED_RS_FILES; do
        if grep -n "TODO\|FIXME" "$file" >/dev/null 2>&1; then
            echo "${YELLOW}! Found TODO/FIXME in $file${NC}"
        fi
    done

    # Check for debug prints
    for file in $STAGED_RS_FILES; do
        if grep -n "println!\|dbg!\|eprintln!" "$file" | grep -v "^[[:space:]]*//"; then
            echo "${YELLOW}! Found debug prints in $file (consider removing or using proper logging)${NC}"
        fi
    done
fi
echo "${GREEN}✓ Staged file checks passed${NC}\n"

# 4. Check for large JSON and Markdown files (>= 500KB) and track with Git LFS
echo "${YELLOW}[4/4] Checking large JSON/MD files for Git LFS...${NC}"
LFS_THRESHOLD_BYTES=${LFS_THRESHOLD_BYTES:-512000} # 500 KB (512,000 bytes)

STAGED_DOC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(json|md)$' || true)

if [ -n "$STAGED_DOC_FILES" ]; then
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        if [ -f "$file" ]; then
            FILE_SIZE=$(wc -c < "$file" | tr -d ' ')
            if [ "$FILE_SIZE" -ge "$LFS_THRESHOLD_BYTES" ]; then
                ATTR=$(git check-attr filter -- "$file" 2>/dev/null | awk '{print $NF}')
                if [ "$ATTR" != "lfs" ]; then
                    if ! command -v git-lfs >/dev/null 2>&1; then
                        echo "${RED}✗ Error: Large file detected ($((FILE_SIZE / 1024)) KB >= 500 KB): $file${NC}"
                        echo "${RED}  git-lfs is required but not installed or not in PATH.${NC}"
                        exit 1
                    fi
                    echo "${YELLOW}! Detected large file ($((FILE_SIZE / 1024)) KB >= 500 KB): $file${NC}"
                    echo "${BLUE}  -> Automatically tracking with Git LFS...${NC}"
                    git lfs track "$file"
                    git add .gitattributes "$file"
                    echo "${GREEN}  ✓ Added $file to Git LFS tracking (.gitattributes updated)${NC}"
                fi
            fi
        fi
    done <<EOF
$STAGED_DOC_FILES
EOF
fi
echo "${GREEN}✓ Git LFS checks passed${NC}\n"

echo "${GREEN}✓ All pre-commit checks passed!${NC}\n"
echo "${GREEN}Ready to commit${NC}"

exit 0
